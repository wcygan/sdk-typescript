{
  "name": "@temporalio/workflow",
  "version": "1.16.0",
  "description": "Temporal.io SDK Workflow sub-package",
  "keywords": [
    "temporal",
    "workflow",
    "isolate"
  ],
  "bugs": {
    "url": "https://github.com/temporalio/sdk-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/temporalio/sdk-typescript.git",
    "directory": "packages/workflow"
  },
  "homepage": "https://github.com/temporalio/sdk-typescript/tree/main/packages/workflow",
  "license": "MIT",
  "author": "Temporal Technologies Inc. <sdk@temporal.io>",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./polyfills": {
      "types": "./lib/polyfills.d.ts",
      "import": "./lib/polyfills.js",
      "require": "./lib/polyfills.js",
      "default": "./lib/polyfills.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "default": "./lib/*.js"
    }
  },
  "scripts": {},
  "dependencies": {
    "@temporalio/common": "workspace:*",
    "@temporalio/proto": "workspace:*",
    "@ungap/structured-clone": "^1.3.0",
    "headers-polyfill": "^4.0.3",
    "nexus-rpc": "^0.0.2",
    "web-streams-polyfill": "^4.2.0"
  },
  "devDependencies": {
    "source-map": "^0.7.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "files": [
    "src",
    "lib"
  ]
}
